# Título exibido na aplicação
VITE_APP_TITLE=NFT Marketplace

# Habilita a camada de mocks (MSW + Socket.IO). true em dev/demonstração.
VITE_ENABLE_MOCKS=true

# URL base da API REST simulada
VITE_API_URL=/api

# URL do servidor Socket.IO simulado (vazio = mesma origem)
VITE_SOCKET_URL=

# Cenário inicial dos mocks (ver src/mocks/scenarios.ts)
VITE_MOCK_SCENARIO=default

# Resend API Key para envio de e-mails (newsletter, etc.)
# Use a mesma chave do dashboard-zecki
VITE_RESEND_API_KEY=
